# ============================================================
# Civic Sentinel — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# -----------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# -----------------------------------------------------------
# DATABASE (Choose ONE)
# -----------------------------------------------------------

# Option A: Local SQLite (development, default)
DATABASE_URL=sqlite://data/civic-sentinel.db

# Option B: Turso Cloud (production, recommended)
# Get free database at: https://turso.tech
# DATABASE_URL=https://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# -----------------------------------------------------------
# SECURITY (CRITICAL — DO NOT USE DEFAULT IN PRODUCTION)
# -----------------------------------------------------------

# Generate strong secret: openssl rand -base64 32
JWT_SECRET=change-me-in-production-minimum-32-characters-long

# JWT Expiration
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Argon2 Password Hashing
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# -----------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------
# NOTIFICATIONS (Optional — enable what you need)
# -----------------------------------------------------------

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# LINE Notify (Thailand)
# LINE_CHANNEL_TOKEN=your-line-channel-token

# Webhook
# WEBHOOK_URL=https://your-webhook-endpoint.com

# -----------------------------------------------------------
# LOGGING
# -----------------------------------------------------------
RUST_LOG=info

# -----------------------------------------------------------
# FRONTEND (Vite)
# -----------------------------------------------------------
VITE_API_URL=http://localhost:3000
